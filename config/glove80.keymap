/*
 * Glove80 QWERTY / home-row mods, derived from user's simplified v52 keymap.
 *
 * Seven layers (by numeric index):
 *   0 QWERTY       1 Cursor       2 Number       3 Symbol
 *   4 Terminal     5 Window Mgmt  6 Magic
 *
 * Tap / hold (on QWERTY):
 *   Enter / Terminal (position 57)
 *   Backspace / Cursor (position 69)
 *   Delete / Number (position 70)
 *   Tab / Window Mgmt (position 73)
 *   Space / Symbol (position 74)
 *   Magic / RGB status (hold / tap) on bottom outside corners (64, 79)
 *
 * Cursor: media & PrintScreen/ScrollLock/NumLock on F-row;
 *   normal arrows on home row and Shift+arrows directly above.
 *   Clipboard: LEFT edge = macOS Cmd+X/C/V, RIGHT edge = Linux/Windows Ctrl+X/C/V.
 * Terminal: shell / Readline-style chords on LEFT hand (Bash/Zsh emacs mode).
 * Window Mgmt: F13-F24 on LEFT hand for OS-side shortcuts.
 * Magic retains factory-style Bluetooth, RGB, bootloader and reset controls.
 *
 * No pointing/mouse firmware configuration is required by this keymap.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Home-row modifiers. Holding ~230 ms activates the modifier;
        // opposite-hand chords also resolve reliably. Quick rolling taps
        // favor letters. No preprocessor macros or OS-specific keycodes.

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45 55 56 57 58 59 60 61 62 63 72 73 74 75 76 77 78 79>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 46 47 48 49 50 51 52 53 54 64 65 66 67 68 69 70 71>;
            hold-trigger-on-release;
        };

        // Like MoErgo's factory Magic key: hold for layer 6, tap for RGB status.

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        // Factory-style Bluetooth choices select BLE transport first.

        bt_0: bt_profile_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp GRAVE    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BACKSLASH
                &key_repeat    &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp MINUS
                &caps_word    &hml LGUI A    &hml LALT S    &hml LCTRL D    &hml LSHFT F    &kp G    &kp H    &hmr RSHFT J    &hmr RCTRL K    &hmr RALT L    &hmr RGUI SEMI    &kp SQT
                &sk LSHFT    &kp Z    &kp X    &kp C    &kp V    &kp B    &kp ESC    &kp UP_ARROW    &kp DOWN    &kp LEFT    &kp RIGHT    &lt 4 RET    &kp N    &kp M    &kp COMMA    &kp DOT    &kp FSLH    &sk RSHFT
                &magic 6 0    &kp BSLH    &kp LS(N9)    &kp LS(N0)    &kp LALT    &lt 1 BSPC    &lt 2 DEL    &kp INSERT    &kp DOWN    &lt 5 TAB    &lt 3 SPACE    &kp RALT    &kp LBKT    &kp RBKT    &kp GRAVE    &magic 6 0
            >;
        };

        cursor_layer {
            display-name = "Cursor";

            // Cmd shortcuts at left end, Ctrl shortcuts at right end of left-hand rows 3-5.
            // Shift+arrows directly above arrows on right-hand home row.
            bindings = <
                &kp C_VOL_DN    &kp C_VOL_UP    &kp C_MUTE    &kp C_PLAY_PAUSE    &kp C_PREV    &kp C_NEXT    &kp PRINTSCREEN    &kp SLCK    &kp KP_NUM    &trans
                &trans    &kp ESC    &kp INS    &kp LS(TAB)    &kp DEL    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &kp LG(X)    &kp RET    &kp SPACE    &kp TAB    &kp BSPC    &kp LC(X)    &trans    &kp LS(LEFT)    &kp LS(UP)    &kp LS(DOWN)    &kp LS(RIGHT)    &trans
                &kp LG(C)    &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &kp LC(C)    &trans    &kp LEFT    &kp UP    &kp DOWN    &kp RIGHT    &trans
                &kp LG(V)    &kp HOME    &kp PG_UP    &kp PG_DN    &kp END    &kp LC(V)    &trans    &trans    &trans    &trans    &trans    &trans    &kp BSPC    &kp HOME    &kp PG_UP    &kp PG_DN    &kp END    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &kp CARET    &trans    &trans    &trans    &kp PERCENT    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &kp PLUS    &kp N7    &kp N8    &kp N9    &kp COLON    &trans
                &trans    &kp LGUI    &kp LALT    &kp LCTRL    &kp LSHFT    &trans    &kp ASTERISK    &kp N4    &kp N5    &kp N6    &kp MINUS    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp COMMA    &kp SLASH    &kp N1    &kp N2    &kp N3    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp DOT    &kp N0    &kp EQUAL    &trans    &trans    &trans    &trans
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &kp GRAVE    &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS    &kp SEMI    &kp COMMA    &trans    &trans    &trans    &trans    &trans    &trans
                &kp EXCLAMATION    &kp LBKT    &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp RBKT    &kp QUESTION    &trans    &trans    &trans    &trans    &trans    &trans
                &kp HASH    &kp CARET    &kp EQUAL    &kp UNDERSCORE    &kp DOLLAR    &kp ASTRK    &trans    &trans    &trans    &trans    &trans    &trans
                &kp TILDE    &kp LESS_THAN    &kp PIPE    &kp MINUS    &kp GREATER_THAN    &kp FSLH    &kp BSLH    &kp DOT    &kp ASTERISK    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &kp AT    &kp AMPS    &kp SQT    &kp DOUBLE_QUOTES    &kp PLUS    &kp PERCENT    &kp COLON    &kp AT    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        terminal_layer {
            display-name = "Terminal";

            // Bash/Zsh Readline / Emacs-style chords, mapped to left hand.
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &kp LC(A)    &kp LC(E)    &kp LC(U)    &kp LC(K)    &kp LC(W)    &kp LC(R)    &trans    &trans    &trans    &trans    &trans    &trans
                &kp LC(P)    &kp LC(N)    &kp LA(B)    &kp LA(F)    &kp LC(L)    &kp LC(D)    &trans    &trans    &trans    &trans    &trans    &trans
                &kp LC(C)    &kp LC(Z)    &kp LC(Y)    &kp LC(T)    &kp LA(D)    &kp LC(B)    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        window_layer {
            display-name = "Window Mgmt";

            // F13-F24 on left hand only; assign intended actions in each host OS.
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &kp F13    &kp F14    &kp F15    &kp F16    &kp F17    &kp F18    &trans    &trans    &trans    &trans    &trans    &trans
                &kp F19    &kp F20    &kp F21    &kp F22    &kp F23    &kp F24    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        magic_layer {
            display-name = "Magic";

            // Factory-style hardware controls, unchanged from uploaded keymap.
            bindings = <
                &bt BT_CLR    &none    &none    &none    &none    &none    &none    &none    &none    &bt BT_CLR_ALL
                &to 0    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
                &none    &rgb_ug RGB_SPI    &rgb_ug RGB_SAI    &rgb_ug RGB_HUI    &rgb_ug RGB_BRI    &rgb_ug RGB_TOG    &none    &none    &none    &none    &none    &none
                &bootloader    &rgb_ug RGB_SPD    &rgb_ug RGB_SAD    &rgb_ug RGB_HUD    &rgb_ug RGB_BRD    &rgb_ug RGB_EFF    &none    &none    &none    &none    &none    &bootloader
                &sys_reset    &none    &none    &none    &none    &none    &bt_2    &bt_3    &none    &none    &none    &none    &none    &none    &none    &none    &none    &sys_reset
                &none    &none    &none    &none    &none    &bt_0    &bt_1    &out OUT_USB    &none    &none    &none    &none    &none    &none    &none    &none
            >;
        };
    };
};
